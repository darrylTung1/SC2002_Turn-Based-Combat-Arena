# Enforce LF line endings for all text files
* text=auto eol=lf

# Java source files — always LF
*.java text eol=lf

# Config / markup files — always LF
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.mermaid text eol=lf

# Windows batch scripts — CRLF where needed
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.zip binary
*.tar.gz binary
*.jar binary
*.class binary
