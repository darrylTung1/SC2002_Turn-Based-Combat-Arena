classDiagram
    direction TB

    %% ========== BOUNDARY LAYER ==========
    namespace Boundary {
        class App {
            +main(String[] args)$
        }

        %% ISP: SetupUI — only GameController calls these methods
        class SetupUI {
            <<interface>>
            +selectPlayer() Player
            +selectItems() List~Item~
            +selectDifficulty() Difficulty
            +promptReplay() boolean
            +promptNewGame() boolean
        }

        %% ISP: BattleUI — only BattleEngine calls these methods
        class BattleUI {
            <<interface>>
            +getPlayerAction(Player, BattleContext) Action
            +selectTarget(List~Combatant~) Combatant
            +selectItem(List~Item~) Item
            +displayBattleStart(Player, List~Enemy~)
            +displayRoundStart(int)
            +displayRoundEnd(BattleContext)
            +displayStunned(Combatant)
            +displayBackupSpawn(List~Enemy~)
            +displayActionResult(Combatant, Action, BattleContext)
            +displayVictory(BattleContext)
            +displayDefeat(BattleContext)
        }

        %% CLIView implements both — each client only sees the interface it needs
        class CLIView {
            -scanner : Scanner
            -readInt(int, int) int
            -createItem(int) Item
        }
    }

    %% ========== CONTROL LAYER ==========
    namespace Control {
        class GameController {
            -setupUI : SetupUI
            -battleUI : BattleUI
            +run()
            %% Instantiates CLIView; holds as SetupUI and passes battleUI to BattleEngine
        }

        class BattleEngine {
            -turnOrderStrategy : TurnOrderStrategy
            -ui : BattleUI
            -context : BattleContext
            -backupSpawned : boolean
            +startBattle(Player, Level)
            -executeRound()
            -executeTurn(Combatant)
            -executePlayerTurn(Player)
            -executeEnemyTurn(Enemy)
            %% Damage: pipe rawDamage through target.effects.modifyIncomingDamage() — no concrete refs
        }

        class BattleContext {
            -player : Player
            -enemies : List~Enemy~
            -currentRound : int
            -selectedTarget : Combatant
            +getPlayer() Player
            +getAliveEnemies() List~Enemy~
            +getAllEnemies() List~Enemy~
            +getAliveCombatants() List~Combatant~
            +addEnemies(List~Enemy~)
            +allEnemiesDefeated() boolean
            +isPlayerDefeated() boolean
            +incrementRound()
            +getCurrentRound() int
            +setSelectedTarget(Combatant)
            +getSelectedTarget() Combatant
        }
    }

    %% ========== ENTITY LAYER: Level ==========
    %% Declared next to Control — BattleEngine.startBattle(Player, Level)
    namespace Entity_Level {
        class Level {
            -difficulty : Difficulty
            -levelNumber : int
            +getInitialSpawn() List~Enemy~
            +getBackupSpawn() List~Enemy~
            +hasBackupSpawn() boolean
            +getDifficulty() Difficulty
            +getLevelNumber() int
        }

        class Difficulty {
            <<enumeration>>
            EASY
            MEDIUM
            HARD
            +getDisplayName() String
        }
    }

    %% ========== ENTITY LAYER: Strategies ==========
    %% Declared next to Control — BattleEngine uses TurnOrderStrategy; Enemy uses EnemyActionStrategy
    namespace Entity_Strategies {
        class TurnOrderStrategy {
            <<interface>>
            +determineTurnOrder(List~Combatant~) List~Combatant~
        }

        class SpeedBasedTurnOrder {
            +determineTurnOrder(List~Combatant~) List~Combatant~
        }

        class EnemyActionStrategy {
            <<interface>>
            +chooseAction(Enemy, BattleContext) Action
        }

        class BasicAttackOnlyStrategy {
            +chooseAction(Enemy, BattleContext) Action
        }
    }

    %% ========== ENTITY LAYER: Combatants ==========
    %% Central hub — referenced by Control, Strategies, Actions, Effects, Items
    namespace Entity_Combatants {
        class Combatant {
            <<abstract>>
            -name : String
            -hp : int
            -maxHp : int
            -attack : int
            -baseAttack : int
            -defense : int
            -baseDefense : int
            -speed : int
            -statusEffects : List~StatusEffect~
            +takeDamage(int rawDamage)
            +heal(int amount)
            +isAlive() boolean
            +isStunned() boolean
            +addStatusEffect(StatusEffect)
            +removeExpiredEffects()
            +tickEffects()
            +hasEffect(Class) boolean
            +getEffect(Class~T~) T
            +modifyAttack(int delta)
            +modifyDefense(int delta)
            +resetDefense()
            +resetAttack()
            +getName() String
            +getHp() int
            +getMaxHp() int
            +getAttack() int
            +getDefense() int
            +getSpeed() int
        }

        class Player {
            <<abstract>>
            -items : List~Item~
            -specialSkillCooldown : int
            +addItem(Item)
            +removeItem(Item)
            +hasItems() boolean
            +getItems() List~Item~
            +decrementCooldown()
            +isSpecialSkillReady() boolean
            +getSpecialSkillCooldown() int
            +setSpecialSkillCooldown(int)
            +executeSpecialSkill(Combatant target, List~Combatant~ allEnemies)*
            +getSpecialSkillName()* String
        }

        class Enemy {
            <<abstract>>
            -actionStrategy : EnemyActionStrategy
            +getActionStrategy() EnemyActionStrategy
        }

        class Warrior {
            +executeSpecialSkill(Combatant target, List~Combatant~ allEnemies)
            +getSpecialSkillName() String
            %% ShieldBash: deals BasicAttack damage + applies StunEffect(2) to target
        }

        class Wizard {
            +executeSpecialSkill(Combatant target, List~Combatant~ allEnemies)
            +getSpecialSkillName() String
            %% ArcaneBlast: hits all enemies; per kill applies ArcaneBlastBuff(+10) to self
        }

        class Goblin {
            +Goblin(String name)
            +Goblin()
            %% HP:55 ATK:35 DEF:15 SPD:25
        }

        class Wolf {
            +Wolf(String name)
            +Wolf()
            %% HP:40 ATK:45 DEF:5 SPD:35
        }
    }

    %% ========== ENTITY LAYER: Items ==========
    %% Declared next to Combatants — Player carries Items; UseItemAction (below) uses Item
    namespace Entity_Items {
        class Item {
            <<interface>>
            +use(Player player, BattleContext context)
            +getName() String
            +getDescription() String
        }

        class Potion {
            -HEAL_AMOUNT : int$
            %% use: player.heal(100); capped at maxHp
        }

        class PowerStone {
            %% use: player.executeSpecialSkill(target, aliveEnemies)
            %% Does NOT reset or affect cooldown
        }

        class SmokeBomb {
            %% use: player.addStatusEffect(new SmokeBombEffect(2))
        }
    }

    %% ========== ENTITY LAYER: Actions ==========
    %% Declared next to Items — UseItemAction uses Item; Actions also target Combatants (above)
    namespace Entity_Actions {
        class Action {
            <<interface>>
            +execute(Combatant actor, BattleContext context)
            +getName() String
            +isAvailable(Combatant actor, BattleContext context) boolean
        }

        class BasicAttack {
            -target : Combatant
            +setTarget(Combatant)
            +getTarget() Combatant
            %% Damage = max(0, actor.getAttack() - target.getDefense())
        }

        class DefendAction {
            %% Applies DefendBuff(2) to actor; isAvailable: always true
        }

        class UseItemAction {
            -selectedItem : Item
            +setSelectedItem(Item)
            +getSelectedItem() Item
            %% isAvailable: player.hasItems()
        }

        class SpecialSkillAction {
            -target : Combatant
            +setTarget(Combatant)
            +getTarget() Combatant
            %% execute: casts actor to Player → player.executeSpecialSkill(target, aliveEnemies)
            %% Sets cooldown to 3; isAvailable: player.isSpecialSkillReady()
        }
    }

    %% ========== ENTITY LAYER: Status Effects ==========
    %% Declared last — created by Actions and Combatants (both above); carried by Combatant
    namespace Entity_Effects {
        class StatusEffect {
            <<interface>>
            +tick(Combatant)
            +onApply(Combatant)
            +onExpire(Combatant)
            +isExpired() boolean
            +getRemainingDuration() int
            %% -1 = indefinite; >= 0 = countdown
            +modifyIncomingDamage(int damage) int
            %% default: return damage unchanged; override to reduce/nullify (OCP)
            +getName() String
        }

        class StunEffect {
            -remainingDuration : int
            +StunEffect(int duration)
            %% onApply: no-op | tick: decrement | onExpire: no-op
        }

        class DefendBuff {
            -remainingDuration : int
            -DEFENSE_BONUS : int$
            +DefendBuff(int duration)
            %% onApply: combatant.modifyDefense(+10) | onExpire: combatant.resetDefense()
        }

        class SmokeBombEffect {
            -remainingDuration : int
            +SmokeBombEffect(int duration)
            %% modifyIncomingDamage: returns 0 (nullifies all incoming damage)
            %% tick: decrement | onApply / onExpire: no-op
        }

        class ArcaneBlastBuff {
            -totalBonusAttack : int
            -expired : boolean
            +ArcaneBlastBuff()
            +addKillBonus(int bonus, Combatant wizard)
            +getBonusAttack() int
            +expire(Combatant wizard)
            +isExpired() boolean
            +getRemainingDuration() int
            %% getRemainingDuration: -1 (indefinite — lasts until level end)
            %% addKillBonus: wizard.modifyAttack(+10); totalBonusAttack += 10
            %% expire: wizard.resetAttack(); expired = true (called at level end)
            %% tick / onApply / onExpire: no-op
        }
    }

    %% ========== ISP: CLIView implements both focused interfaces ==========
    SetupUI <|.. CLIView
    BattleUI <|.. CLIView

    %% ========== INHERITANCE ==========
    Combatant <|-- Player
    Combatant <|-- Enemy
    Player <|-- Warrior
    Player <|-- Wizard
    Enemy <|-- Goblin
    Enemy <|-- Wolf

    %% ========== INTERFACE IMPLEMENTATIONS ==========
    Action <|.. BasicAttack
    Action <|.. DefendAction
    Action <|.. UseItemAction
    Action <|.. SpecialSkillAction

    StatusEffect <|.. StunEffect
    StatusEffect <|.. DefendBuff
    StatusEffect <|.. SmokeBombEffect
    StatusEffect <|.. ArcaneBlastBuff

    Item <|.. Potion
    Item <|.. PowerStone
    Item <|.. SmokeBomb

    TurnOrderStrategy <|.. SpeedBasedTurnOrder
    EnemyActionStrategy <|.. BasicAttackOnlyStrategy

    %% ========== ASSOCIATIONS ==========
    Combatant "1" o-- "*" StatusEffect : has
    Player "1" o-- "0..2" Item : carries
    Enemy "1" --> "1" EnemyActionStrategy : uses

    BattleEngine "1" --> "1" TurnOrderStrategy : uses
    BattleEngine "1" --> "1" BattleUI : uses
    BattleEngine "1" --> "1" BattleContext : manages

    BattleContext "1" --> "1" Player : references
    BattleContext "1" --> "*" Enemy : references

    App ..> GameController : creates
    GameController "1" --> "1" SetupUI : uses
    GameController "1" --> "1" BattleUI : passes to BattleEngine
    GameController ..> BattleEngine : creates

    Level "1" --> "1" Difficulty : has
    Level ..> Enemy : creates

    UseItemAction ..> Item : uses
    BasicAttack ..> Combatant : targets
    SpecialSkillAction ..> Combatant : targets
    SpecialSkillAction ..> Player : delegates to
    DefendAction ..> DefendBuff : creates
    Warrior ..> StunEffect : creates
    Wizard ..> ArcaneBlastBuff : creates
    SmokeBomb ..> SmokeBombEffect : creates
